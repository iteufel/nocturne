[Unit]
Description=Nocturne encrypted rendezvous and relay broker
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/nocturne-broker/certs/fullchain.pem
ConditionPathExists=/etc/nocturne-broker/certs/privkey.pem

[Container]
Image=docker.io/iteufel/nocturne-broker:latest
Pull=missing
AutoUpdate=registry
Notify=healthy
ContainerName=nocturne-broker
User=10001:10001
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
PublishPort=80:8080/tcp
PublishPort=443:8443/tcp
PublishPort=7842:7842/udp
Volume=/etc/nocturne-broker/certs:/certs:ro
Environment=NOCTURNE_BROKER_CERT=/certs/fullchain.pem
Environment=NOCTURNE_BROKER_KEY=/certs/privkey.pem
Environment=NOCTURNE_BROKER_HTTP=0.0.0.0:8080
Environment=NOCTURNE_BROKER_HTTPS=0.0.0.0:8443
Environment=NOCTURNE_BROKER_QUIC=0.0.0.0:7842
Environment=NOCTURNE_BROKER_METRICS=127.0.0.1:9090
Environment=NOCTURNE_BROKER_BYTES_PER_SECOND=12500000
Environment=RUST_LOG=info
LogDriver=journald
HealthCmd=curl -fsS --resolve nocturne.alkal.de:8443:127.0.0.1 https://nocturne.alkal.de:8443/ping
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthOnFailure=kill
PodmanArgs=--memory=512m --pids-limit=64

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
