<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Nocturne Server</AssemblyName>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <ProjectReference Include="../Nocturne.Host/Nocturne.Host.csproj" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
</Project>
