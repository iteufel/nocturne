<Window x:Class="Nocturne.Server.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Nocturne Server" Icon="app.ico" Width="1000" Height="740" MinWidth="820" MinHeight="640"
 WindowStartupLocation="CenterScreen" Closing="WindowClosing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="206" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="#191C28" Padding="24,32">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="☾" Foreground="{StaticResource Accent}" FontSize="44" Margin="0,0,0,12" />
     <TextBlock Text="Nocturne" FontFamily="Bahnschrift" FontSize="25" />
     <TextBlock Text="SERVER FOR WINDOWS" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,32" />
     <Button Content="_Overview" HorizontalContentAlignment="Left" Click="Navigate" Tag="Overview" Margin="0,0,0,10" />
     <Button Content="_Sharing" Click="Navigate" Tag="Sharing" Margin="0,0,0,10" />
     <Button Content="_Devices" Click="Navigate" Tag="Devices" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <TextBlock Text="Your desktop.&#x0a;Within reach." FontSize="17" LineHeight="25" Margin="0,0,0,20" />
     <TextBlock Text="Keep this window open while connected." Style="{StaticResource Caption}" />
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="38,34">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,24">
    <Button DockPanel.Dock="Right" Content="Pair a device" Style="{StaticResource Primary}" IsEnabled="{Binding CanPair}" Click="PairDevice" />
    <StackPanel><TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Foreground="{StaticResource Mint}" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite" /></StackPanel>
   </DockPanel>
   <Border Grid.Row="1" Background="#402E36" Padding="14" CornerRadius="7" Margin="0,0,0,18" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
    <TextBlock Text="{Binding Error}" Foreground="#FFD5D9" AutomationProperties.LiveSetting="Assertive" />
   </Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
    <Grid>
     <StackPanel x:Name="Overview">
      <TextBlock Text="Your PC,&#x0a;on your terms." FontFamily="Bahnschrift" FontSize="40" LineHeight="47" Margin="0,8,0,16" />
      <TextBlock Text="Stream your desktop to iPhone and iPad. Bring a terminal and your files along, with one private connection." Style="{StaticResource Caption}" MaxWidth="490" HorizontalAlignment="Left" Margin="0,0,0,28" />
      <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="24" Margin="0,0,0,22">
       <StackPanel>
        <TextBlock Text="Desktop streaming" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Uses your connected monitor and Windows audio. In the iOS app, choose a fixed resolution such as 1080p before opening Desktop." Style="{StaticResource Caption}" Margin="0,10,0,20" />
        <Button Content="{Binding StartLabel}" Style="{StaticResource Primary}" Click="ToggleServer" IsEnabled="{Binding CanAct}" HorizontalAlignment="Left" MinWidth="146" />
       </StackPanel>
      </Border>
      <TextBlock Text="Connect on the same network" FontWeight="SemiBold" Margin="0,0,0,8" />
      <TextBlock Text="Start the server, allow access on private networks if Windows asks, then choose Pair a device and scan the code in Nocturne on your iPhone or iPad." Style="{StaticResource Caption}" />
      <Button Content="Open server log" Click="OpenLog" HorizontalAlignment="Left" Margin="0,22,0,0" />
     </StackPanel>
     <StackPanel x:Name="Sharing" Visibility="Collapsed">
      <TextBlock Text="Share what&#x0a;you need." FontFamily="Bahnschrift" FontSize="36" Margin="0,8,0,20" />
      <TextBlock Text="Stop the server to change these settings. Reconnect your device after saving." Style="{StaticResource Caption}" Margin="0,0,0,20" />
      <StackPanel IsEnabled="{Binding CanConfigure}">
       <Label Target="{Binding ElementName=ComputerName}" Foreground="{StaticResource Ink}" Content="Computer _name" />
       <TextBox x:Name="ComputerName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Margin="0,0,0,18" />
       <CheckBox Content="Allow _terminal access" IsChecked="{Binding Terminal}" />
       <TextBlock Text="Paired devices can run PowerShell commands as your Windows user. Tabs keep running while your device is disconnected." Style="{StaticResource Caption}" Margin="0,0,0,12" />
       <CheckBox Content="Allow _file sharing" IsChecked="{Binding Files}" />
       <TextBlock Text="Choose one local folder. Uploads cannot replace existing files; shortcuts and junctions are excluded." Style="{StaticResource Caption}" Margin="0,0,0,10" />
       <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="Choose folder…" Click="ChooseFolder" Margin="10,0,0,0" /><TextBox Text="{Binding SharedFolder}" IsReadOnly="True" AutomationProperties.Name="Shared folder" VerticalContentAlignment="Center" /></DockPanel>
       <Button Content="Save settings" Click="SaveSettings" HorizontalAlignment="Left" Style="{StaticResource Primary}" />
      </StackPanel>
      <TextBlock Text="Headless displays and client microphone forwarding are currently available on the Mac host. Windows streams an active desktop monitor." Style="{StaticResource Caption}" Margin="0,26,0,0" />
     </StackPanel>
     <StackPanel x:Name="Devices" Visibility="Collapsed">
      <TextBlock Text="Your devices." FontFamily="Bahnschrift" FontSize="36" Margin="0,8,0,14" />
      <TextBlock Text="Removing a device disconnects its workspace, closes its terminals, and revokes its streaming access. Start the server to finish removal." Style="{StaticResource Caption}" Margin="0,0,0,24" />
      <ItemsControl ItemsSource="{Binding Devices}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="18" Margin="0,0,0,10">
         <DockPanel><Button DockPanel.Dock="Right" Content="Remove…" Click="RemoveDevice" Tag="{Binding}" IsEnabled="{Binding DataContext.CanPair, RelativeSource={RelativeSource AncestorType=Window}}" Margin="16,0,0,0" />
          <StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel>
         </DockPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="No paired devices yet. Start the server and choose Pair a device." Style="{StaticResource Caption}" Visibility="{Binding NoDevices, Converter={StaticResource Visible}}" />
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock Grid.Row="3" Text="Closing Nocturne stops streaming, terminals, and file transfers." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,22,0,0" />
  </Grid>
 </Grid>
</Window>
