<Application x:Class="Nocturne.Server.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="Canvas" Color="#10121B" />
  <SolidColorBrush x:Key="Surface" Color="#232630" />
  <SolidColorBrush x:Key="Elevated" Color="#303440" />
  <SolidColorBrush x:Key="Ink" Color="#F4F5FA" />
  <SolidColorBrush x:Key="Muted" Color="#B0B5C7" />
  <SolidColorBrush x:Key="Accent" Color="#BEBAFF" />
  <SolidColorBrush x:Key="Mint" Color="#8CDDBB" />
  <SolidColorBrush x:Key="Sidebar" Color="#191C28" />
  <SolidColorBrush x:Key="ErrorSurface" Color="#402E36" />
  <SolidColorBrush x:Key="ErrorInk" Color="#FFD5D9" />
  <SolidColorBrush x:Key="AccentInk" Color="#10121B" />
  <BooleanToVisibilityConverter x:Key="Visible" />
  <Style TargetType="Window">
   <Setter Property="Background" Value="{DynamicResource Canvas}" />
   <Setter Property="Foreground" Value="{DynamicResource Ink}" />
   <Setter Property="FontFamily" Value="Segoe UI" />
   <Setter Property="FontSize" Value="14" />
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="{DynamicResource Muted}" />
   <Setter Property="FontSize" Value="13" />
   <Setter Property="LineHeight" Value="21" />
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Elevated}" />
   <Setter Property="Foreground" Value="{DynamicResource Ink}" />
   <Setter Property="Padding" Value="18,11" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
      <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.8" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter TargetName="Border" Property="BorderThickness" Value="2" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.4" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource Accent}" />
   <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
   <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource Canvas}" />
   <Setter Property="Foreground" Value="{DynamicResource Ink}" />
   <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
   <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
   <Setter Property="Padding" Value="10,8" />
   <Setter Property="FontSize" Value="14" />
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource Ink}" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
   <Setter Property="Margin" Value="0,10" />
   <Setter Property="FontSize" Value="15" />
  </Style>
 </Application.Resources>
</Application>
